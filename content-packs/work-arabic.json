      "order": 90
    }
  ],
  "items": [
    {
      "id": "wk-l1-01",
      "type": "word",
      "arabic": "تعال",
      "bangla": "আসো / এদিকে আসো",
      "english": "Come here",
      "bn_transliteration": "তাআল",
      "en_transliteration": "taʿāl",
      "category_ids": [
        "boss"
      ],
      "note_bn": "বস সবচেয়ে বেশি বলে। নারীকে বললে: 'তাআলি'।",
      "note_en": "The word bosses use most. To a woman: taʿāli."
    },
    {
      "id": "wk-l1-02",
      "type": "word",
      "arabic": "روح",
      "bangla": "যাও",
      "english": "Go",
      "bn_transliteration": "রূহ",
      "en_transliteration": "rūḥ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-03",
      "type": "word",
      "arabic": "يلا",
      "bangla": "চলো / তাড়াতাড়ি করো",
      "english": "Come on, let's go",
      "bn_transliteration": "ইয়াল্লা",
      "en_transliteration": "yalla",
      "category_ids": [
        "boss"
      ],
      "note_bn": "তাড়া দিতে বা 'শুরু করো' বোঝাতে বলে। রাগ না, সাধারণ কথা।",
      "note_en": "Used to hurry someone or say 'let's start'. It isn't rude."
    },
    {
      "id": "wk-l1-04",
      "type": "word",
      "arabic": "خذ",
      "bangla": "নাও",
      "english": "Take",
      "bn_transliteration": "খুদ",
      "en_transliteration": "khudh",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-05",
      "type": "phrase",
      "arabic": "حط هنا",
      "bangla": "এখানে রাখো",
      "english": "Put it here",
      "bn_transliteration": "হুত্ত হিনা",
      "en_transliteration": "ḥuṭṭ hina",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'হুত্ত' মানে রাখো — সৌদিতে খুব বলে।",
      "note_en": "ḥuṭṭ means 'put' and is very common."
    },
    {
      "id": "wk-l1-06",
      "type": "phrase",
      "arabic": "شيل هذا",
      "bangla": "এটা তোলো / সরাও",
      "english": "Lift this / Take this away",
      "bn_transliteration": "শীল হাদা",
      "en_transliteration": "shīl hādha",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'শীল' মানে তোলা বা সরানো দুটোই।",
      "note_en": "shīl means both 'lift' and 'take away'."
    },
    {
      "id": "wk-l1-07",
      "type": "phrase",
      "arabic": "نظف المكان",
      "bangla": "জায়গাটা পরিষ্কার করো",
      "english": "Clean the place",
      "bn_transliteration": "নাদ্দিফ আল-মাকান",
      "en_transliteration": "naẓẓif al-makān",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-08",
      "type": "word",
      "arabic": "رتب",
      "bangla": "সাজাও / গুছিয়ে রাখো",
      "english": "Arrange it, tidy it",
      "bn_transliteration": "রাত্তিব",
      "en_transliteration": "rattib",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-09",
      "type": "word",
      "arabic": "بسرعة",
      "bangla": "তাড়াতাড়ি",
      "english": "Quickly",
      "bn_transliteration": "বিসুরআ",
      "en_transliteration": "bsurʿa",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-10",
      "type": "word",
      "arabic": "اسمع",
      "bangla": "শোনো",
      "english": "Listen",
      "bn_transliteration": "ইসমা",
      "en_transliteration": "ismaʿ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-11",
      "type": "word",
      "arabic": "شوف",
      "bangla": "দেখো",
      "english": "Look",
      "bn_transliteration": "শূফ",
      "en_transliteration": "shūf",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'শূফ' দিয়ে কথা শুরু করলে মানে 'দেখো, ব্যাপারটা হলো...'।",
      "note_en": "At the start of a sentence, shūf means 'look, the thing is...'."
    },
    {
      "id": "wk-l1-12",
      "type": "phrase",
      "arabic": "لا تلمس",
      "bangla": "ছুঁয়ো না",
      "english": "Don't touch",
      "bn_transliteration": "লা তিলমিস",
      "en_transliteration": "lā tilmis",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l1-13",
      "type": "word",
      "arabic": "انتبه",
      "bangla": "সাবধান",
      "english": "Be careful",
      "bn_transliteration": "ইনতাবিহ",
      "en_transliteration": "intabih",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-01",
      "type": "word",
      "arabic": "الشغل",
      "bangla": "কাজ",
      "english": "The work",
      "bn_transliteration": "আশ-শুগুল",
      "en_transliteration": "ash-shughul",
      "category_ids": [
        "boss"
      ],
      "note_bn": "সৌদিরা কাজকে 'শুগুল' বলে, বইয়ের 'আমাল' কম শোনা যায়।",
      "note_en": "Saudis say shughul for work; the textbook ʿamal is heard less."
    },
    {
      "id": "wk-l2-02",
      "type": "word",
      "arabic": "الدوام",
      "bangla": "ডিউটি / অফিসের সময়",
      "english": "Working hours, shift",
      "bn_transliteration": "আদ-দাওয়াম",
      "en_transliteration": "ad-dawām",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'দাওয়াম কাম সাআ?' মানে ডিউটি কত ঘণ্টা?",
      "note_en": "dawām kam sāʿa? means 'how many hours is the shift?'"
    },
    {
      "id": "wk-l2-03",
      "type": "word",
      "arabic": "ابدأ",
      "bangla": "শুরু করো",
      "english": "Start",
      "bn_transliteration": "ইবদা",
      "en_transliteration": "ibda",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-04",
      "type": "word",
      "arabic": "كمل",
      "bangla": "চালিয়ে যাও / শেষ করো",
      "english": "Carry on, finish it",
      "bn_transliteration": "কাম্মিল",
      "en_transliteration": "kammil",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-05",
      "type": "word",
      "arabic": "وقف",
      "bangla": "থামো",
      "english": "Stop",
      "bn_transliteration": "ওয়াগগিফ",
      "en_transliteration": "wagguf",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-06",
      "type": "word",
      "arabic": "ارجع",
      "bangla": "ফিরে আসো",
      "english": "Come back",
      "bn_transliteration": "ইরজা",
      "en_transliteration": "irjaʿ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-07",
      "type": "word",
      "arabic": "جيب",
      "bangla": "নিয়ে আসো",
      "english": "Bring",
      "bn_transliteration": "জীব",
      "en_transliteration": "jīb",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-08",
      "type": "phrase",
      "arabic": "جيب لي الكرتون",
      "bangla": "আমাকে কার্টনটা এনে দাও",
      "english": "Bring me the box",
      "bn_transliteration": "জীব লি আল-কারতূন",
      "en_transliteration": "jīb li l-kartūn",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-09",
      "type": "phrase",
      "arabic": "وين المفتاح؟",
      "bangla": "চাবি কোথায়?",
      "english": "Where is the key?",
      "bn_transliteration": "ওয়েন আল-মিফতাহ?",
      "en_transliteration": "wēn al-miftāḥ?",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-10",
      "type": "phrase",
      "arabic": "سكر الباب",
      "bangla": "দরজা বন্ধ করো",
      "english": "Close the door",
      "bn_transliteration": "সাক্কির আল-বাব",
      "en_transliteration": "sakkir al-bāb",
      "category_ids": [
        "boss"
      ],
      "note_bn": "সৌদিতে 'বন্ধ করো' = 'সাক্কির'। খোলো = 'ইফতাহ'।",
      "note_en": "In Saudi, 'close' is sakkir. 'Open' is iftaḥ."
    },
    {
      "id": "wk-l2-11",
      "type": "word",
      "arabic": "افتح",
      "bangla": "খোলো",
      "english": "Open",
      "bn_transliteration": "ইফতাহ",
      "en_transliteration": "iftaḥ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-12",
      "type": "phrase",
      "arabic": "بكرة الصبح",
      "bangla": "আগামীকাল সকালে",
      "english": "Tomorrow morning",
      "bn_transliteration": "বুকরা আস-সুবহ",
      "en_transliteration": "bukra aṣ-ṣubḥ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l2-13",
      "type": "phrase",
      "arabic": "اليوم الشغل كثير",
      "bangla": "আজ কাজ অনেক",
      "english": "There's a lot of work today",
      "bn_transliteration": "আল-ইয়োম আশ-শুগুল কাসীর",
      "en_transliteration": "al-yōm ash-shughul kathīr",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-01",
      "type": "word",
      "arabic": "حاضر",
      "bangla": "জি, এখনই",
      "english": "Yes, right away",
      "bn_transliteration": "হাদির",
      "en_transliteration": "ḥāḍir",
      "category_ids": [
        "boss"
      ],
      "note_bn": "বস ডাকলে বা কিছু বললে ভদ্র উত্তর। 'আবশির'-এর মতোই।",
      "note_en": "A polite answer when your boss calls or asks. Like abshir."
    },
    {
      "id": "wk-l3-02",
      "type": "phrase",
      "arabic": "على راسي",
      "bangla": "মাথায় তুলে নিলাম (অবশ্যই করব)",
      "english": "With pleasure (on my head)",
      "bn_transliteration": "আলা রাসি",
      "en_transliteration": "ʿala rāsi",
      "category_ids": [
        "boss"
      ],
      "note_bn": "খুব সম্মান দেখিয়ে 'অবশ্যই করব' বলা।",
      "note_en": "A very respectful 'of course I'll do it'."
    },
    {
      "id": "wk-l3-03",
      "type": "word",
      "arabic": "خلاص",
      "bangla": "শেষ / ব্যস",
      "english": "Done, that's it",
      "bn_transliteration": "খালাস",
      "en_transliteration": "khalāṣ",
      "category_ids": [
        "boss"
      ],
      "note_bn": "মানে 'শেষ হয়েছে' বা 'ব্যস, আর না'। সুর শুনে বুঝুন।",
      "note_en": "Means 'finished' or 'enough, stop'. Listen to the tone."
    },
    {
      "id": "wk-l3-04",
      "type": "word",
      "arabic": "خلصت",
      "bangla": "আমি শেষ করেছি",
      "english": "I've finished",
      "bn_transliteration": "খাল্লাসত",
      "en_transliteration": "khallaṣt",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-05",
      "type": "phrase",
      "arabic": "باقي شوي",
      "bangla": "আর একটু বাকি",
      "english": "Just a little left",
      "bn_transliteration": "বাগি শুওয়াই",
      "en_transliteration": "bāgi shway",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-06",
      "type": "word",
      "arabic": "الحين",
      "bangla": "এখন",
      "english": "Now",
      "bn_transliteration": "আল-হীন",
      "en_transliteration": "al-ḥīn",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'আল-হীন' মানে এখন — সৌদিতে খুব প্রচলিত।",
      "note_en": "al-ḥīn is the everyday Saudi word for 'now'."
    },
    {
      "id": "wk-l3-07",
      "type": "word",
      "arabic": "دقيقة",
      "bangla": "এক মিনিট",
      "english": "One minute",
      "bn_transliteration": "দাগীগা",
      "en_transliteration": "dagīga",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-08",
      "type": "word",
      "arabic": "انتظر",
      "bangla": "অপেক্ষা করো",
      "english": "Wait",
      "bn_transliteration": "ইনতাদির",
      "en_transliteration": "intaẓir",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-09",
      "type": "phrase",
      "arabic": "اصبر شوي",
      "bangla": "একটু অপেক্ষা করুন",
      "english": "Wait a little",
      "bn_transliteration": "ইসবির শুওয়াই",
      "en_transliteration": "iṣbir shway",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'ইনতাদির'-এর চেয়ে নরম ও বেশি শোনা যায়।",
      "note_en": "Softer than intaẓir, and heard more."
    },
    {
      "id": "wk-l3-10",
      "type": "phrase",
      "arabic": "بشوف",
      "bangla": "আমি দেখছি / চেক করছি",
      "english": "I'll check",
      "bn_transliteration": "বাশূফ",
      "en_transliteration": "bashūf",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'বা-' মানে 'আমি করব'। বাশূফ = আমি দেখব।",
      "note_en": "The ba- means 'I will'. bashūf = I'll look."
    },
    {
      "id": "wk-l3-11",
      "type": "phrase",
      "arabic": "بسأل",
      "bangla": "আমি জিজ্ঞেস করে দেখি",
      "english": "I'll ask",
      "bn_transliteration": "বাসআল",
      "en_transliteration": "basʾal",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-12",
      "type": "phrase",
      "arabic": "ما أقدر",
      "bangla": "আমি পারব না",
      "english": "I can't",
      "bn_transliteration": "মা আগদার",
      "en_transliteration": "mā agdar",
      "category_ids": [
        "boss"
      ],
      "note_bn": "সৌদিতে 'ق' এখানে 'গ': আগদার। পারব = 'আগদার'।",
      "note_en": "The qāf sounds like g. 'I can' is agdar."
    },
    {
      "id": "wk-l3-13",
      "type": "word",
      "arabic": "أقدر",
      "bangla": "আমি পারব",
      "english": "I can",
      "bn_transliteration": "আগদার",
      "en_transliteration": "agdar",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l3-14",
      "type": "phrase",
      "arabic": "ما عندي خبر",
      "bangla": "আমি জানি না / আমাকে বলা হয়নি",
      "english": "I didn't know about it",
      "bn_transliteration": "মা ইনদি খাবার",
      "en_transliteration": "mā ʿindi khabar",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l4-01",
      "type": "phrase",
      "arabic": "أهلين، وش تبغى؟",
      "bangla": "স্বাগতম, কী চান?",
      "english": "Welcome, what would you like?",
      "bn_transliteration": "আহলেইন, ওশ তাবগা?",
      "en_transliteration": "ahlēn, wesh tabgha?",
      "category_ids": [
        "customers"
      ],
      "note_bn": "কাস্টমার এলে প্রথম কথা। নারী কাস্টমারকে: 'ওশ তাবগিন?'",
      "note_en": "The first thing to say to a customer. To a woman: wesh tabghīn?"
    },
    {
      "id": "wk-l4-02",
      "type": "phrase",
      "arabic": "كيف أخدمك؟",
      "bangla": "আপনাকে কীভাবে সাহায্য করতে পারি?",
      "english": "How can I help you?",
      "bn_transliteration": "কেইফ আখদিমাক?",
      "en_transliteration": "kēf akhdimak?",
      "category_ids": [
        "customers"
      ]
    },
    {
      "id": "wk-l4-03",
      "type": "phrase",
      "arabic": "حياك الله",
      "bangla": "আসুন, স্বাগতম",
      "english": "Welcome (God greet you)",
      "bn_transliteration": "হাইয়াক আল্লাহ",
