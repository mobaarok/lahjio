        "time"
      ]
    },
    {
      "id": "wk-l7-14",
      "type": "phrase",
      "arabic": "وقت الصلاة",
      "bangla": "নামাজের সময়",
      "english": "Prayer time",
      "bn_transliteration": "ওয়াগত আস-সালাহ",
      "en_transliteration": "wagt aṣ-ṣalāh",
      "category_ids": [
        "time"
      ],
      "note_bn": "নামাজের সময় অনেক দোকান ১৫-২০ মিনিট বন্ধ থাকে।",
      "note_en": "Many shops close for 15 to 20 minutes at prayer time."
    },
    {
      "id": "wk-l8-01",
      "type": "phrase",
      "arabic": "وش صار؟",
      "bangla": "কী হয়েছে?",
      "english": "What happened?",
      "bn_transliteration": "ওশ সার?",
      "en_transliteration": "wesh ṣār?",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-02",
      "type": "phrase",
      "arabic": "وش أسوي؟",
      "bangla": "আমি কী করব?",
      "english": "What should I do?",
      "bn_transliteration": "ওশ আসাওয়ি?",
      "en_transliteration": "wesh asawwi?",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'সাওয়া' মানে করা — সৌদিতে খুব বলে।",
      "note_en": "sawwa means 'to do', very common in Saudi."
    },
    {
      "id": "wk-l8-03",
      "type": "word",
      "arabic": "ساعدني",
      "bangla": "আমাকে সাহায্য করো",
      "english": "Help me",
      "bn_transliteration": "সাইদনি",
      "en_transliteration": "sāʿidni",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-04",
      "type": "phrase",
      "arabic": "مين المسؤول؟",
      "bangla": "দায়িত্বে কে?",
      "english": "Who is in charge?",
      "bn_transliteration": "মীন আল-মাসউল?",
      "en_transliteration": "mīn al-masʾūl?",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-05",
      "type": "phrase",
      "arabic": "أنا تعبان",
      "bangla": "আমি ক্লান্ত / অসুস্থ",
      "english": "I'm tired / unwell",
      "bn_transliteration": "আনা তাবান",
      "en_transliteration": "ana taʿbān",
      "category_ids": [
        "boss"
      ],
      "note_bn": "'তাবান' মানে ক্লান্ত, আবার অসুস্থও।",
      "note_en": "taʿbān means tired, and also sick."
    },
    {
      "id": "wk-l8-06",
      "type": "word",
      "arabic": "استراحة",
      "bangla": "বিরতি",
      "english": "Break",
      "bn_transliteration": "ইসতিরাহা",
      "en_transliteration": "istirāḥa",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-07",
      "type": "phrase",
      "arabic": "بروح أتغدى",
      "bangla": "আমি দুপুরের খাবার খেতে যাচ্ছি",
      "english": "I'm going for lunch",
      "bn_transliteration": "বারূহ আতগাদ্দা",
      "en_transliteration": "barūḥ atghadda",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-08",
      "type": "phrase",
      "arabic": "ممكن أصلي؟",
      "bangla": "আমি কি নামাজ পড়তে পারি?",
      "english": "May I go and pray?",
      "bn_transliteration": "মুমকিন আসাল্লি?",
      "en_transliteration": "mumkin aṣalli?",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-09",
      "type": "phrase",
      "arabic": "مين معي؟",
      "bangla": "আমার সাথে কে (কাজ করবে)?",
      "english": "Who's working with me?",
      "bn_transliteration": "মীন মাঈ?",
      "en_transliteration": "mīn maʿi?",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-10",
      "type": "phrase",
      "arabic": "الشغل خلص",
      "bangla": "কাজ শেষ",
      "english": "The work is finished",
      "bn_transliteration": "আশ-শুগুল খিলাস",
      "en_transliteration": "ash-shughul khiliṣ",
      "category_ids": [
        "boss"
      ]
    },
    {
      "id": "wk-l8-11",
      "type": "phrase",
      "arabic": "نشوفك بكرة",
      "bangla": "কাল দেখা হবে",
      "english": "See you tomorrow",
      "bn_transliteration": "নিশূফাক বুকরা",
      "en_transliteration": "nishūfak bukra",
      "category_ids": [
        "boss"
      ]
    }
