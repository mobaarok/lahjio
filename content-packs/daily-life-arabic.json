    {
      "id": "dl-l1-01",
      "type": "phrase",
      "arabic": "وين تبي؟",
      "bangla": "কোথায় যাবেন?",
      "english": "Where do you want to go?",
      "bn_transliteration": "ওয়েন তিবি?",
      "en_transliteration": "wēn tibi?",
      "category_ids": [
        "transport"
      ],
      "note_bn": "ড্রাইভারের প্রথম প্রশ্ন। 'তিবি' = 'তাবগা' (চান) — দুটোই সৌদি।",
      "note_en": "The driver's first question. tibi and tabgha both mean 'you want'."
    },
    {
      "id": "dl-l1-02",
      "type": "phrase",
      "arabic": "ودني هنا",
      "bangla": "আমাকে এখানে নিয়ে চলুন",
      "english": "Take me here",
      "bn_transliteration": "ওয়াদ্দিনি হিনা",
      "en_transliteration": "waddini hina",
      "category_ids": [
        "transport"
      ],
      "note_bn": "ফোনে ম্যাপ দেখিয়ে বলুন।",
      "note_en": "Say it while showing the map on your phone."
    },
    {
      "id": "dl-l1-03",
      "type": "phrase",
      "arabic": "كم توصلني؟",
      "bangla": "নিয়ে যেতে কত নেবেন?",
      "english": "How much to take me?",
      "bn_transliteration": "কাম তিওয়াসসিলনি?",
      "en_transliteration": "kam tiwaṣṣilni?",
      "category_ids": [
        "transport"
      ],
      "note_bn": "মিটার না থাকলে ওঠার আগেই দাম ঠিক করুন।",
      "note_en": "If there's no meter, agree the price before you get in."
    },
    {
      "id": "dl-l1-04",
      "type": "phrase",
      "arabic": "شغل العداد",
      "bangla": "মিটার চালু করুন",
