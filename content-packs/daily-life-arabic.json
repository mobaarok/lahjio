    {
      "id": "dl-l8-13",
      "type": "phrase",
      "arabic": "الرقم السري",
      "bangla": "পিন নাম্বার",
      "english": "PIN number",
      "bn_transliteration": "আর-রাগম আস-সিররি",
      "en_transliteration": "ar-ragm as-sirri",
      "category_ids": [
