      "bn_transliteration": "গাইন",
      "en_transliteration": "ghayn",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ع-এর ওপরে এক ফোঁটা। শুরু, মাঝ ও শেষে: غـ ـغـ ـغ।",
      "note_en": "Like ع with a dot above. Start, middle, end: غـ ـغـ ـغ."
    },
