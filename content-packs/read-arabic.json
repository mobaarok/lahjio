      "type": "word",
      "arabic": "ك",
      "bangla": "উচ্চারণ: ক",
      "english": "Sound: k",
      "bn_transliteration": "কাফ",
      "en_transliteration": "kāf",
      "category_ids": [
        "letters"
      ],
      "note_bn": "শুরু, মাঝ ও শেষে: كـ ـكـ ـك।",
      "note_en": "Start, middle, end: كـ ـكـ ـك."
    },
    {
      "id": "rd-l6-04",
      "type": "word",
      "arabic": "ل",
      "bangla": "উচ্চারণ: ল",
