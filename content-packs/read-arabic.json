  "items": [
    {
      "id": "rd-l1-01",
      "type": "word",
      "arabic": "ا",
      "bangla": "উচ্চারণ: আ (লম্বা)",
      "english": "Sound: a, long ā",
      "bn_transliteration": "আলিফ",
      "en_transliteration": "alif",
      "category_ids": [
        "letters"
      ],
      "note_bn": "আরবি ডান থেকে বামে পড়ে। পরের অক্ষরের সাথে জোড়া লাগে না। শুরু, মাঝ ও শেষে: ا ـا।",
      "note_en": "Arabic is read right to left. Never joins to the letter after it. Start, middle, end: ا ـا."
    },
    {
      "id": "rd-l1-02",
      "type": "word",
      "arabic": "ب",
      "bangla": "উচ্চারণ: ব",
      "english": "Sound: b",
      "bn_transliteration": "বা",
      "en_transliteration": "bā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "নিচে এক ফোঁটা। শুরু, মাঝ ও শেষে: بـ ـبـ ـب।",
      "note_en": "One dot below. Start, middle, end: بـ ـبـ ـب."
    },
    {
      "id": "rd-l1-03",
      "type": "word",
      "arabic": "ت",
      "bangla": "উচ্চারণ: ত",
      "english": "Sound: t",
      "bn_transliteration": "তা",
      "en_transliteration": "tā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ওপরে দুই ফোঁটা। শুরু, মাঝ ও শেষে: تـ ـتـ ـت।",
      "note_en": "Two dots above. Start, middle, end: تـ ـتـ ـت."
    },
    {
      "id": "rd-l1-04",
      "type": "word",
      "arabic": "ث",
      "bangla": "উচ্চারণ: স (জিভ দাঁতে, ইংরেজি think-এর th)",
      "english": "Sound: th as in 'think'",
      "bn_transliteration": "সা",
      "en_transliteration": "thā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ওপরে তিন ফোঁটা। সৌদি কথায় অনেকে 'ত' বা 'স' বলে। শুরু, মাঝ ও শেষে: ثـ ـثـ ـث।",
      "note_en": "Three dots above. Many Saudis say it as t or s. Start, middle, end: ثـ ـثـ ـث."
    },
    {
      "id": "rd-l1-05",
      "type": "word",
      "arabic": "باب",
      "bangla": "দরজা",
      "english": "Door",
      "bn_transliteration": "বাব",
      "en_transliteration": "bāb",
      "category_ids": [
        "letters"
      ],
      "note_bn": "প্রথম শব্দ পড়া! ب + ا + ب = বাব।",
      "note_en": "Your first word! ب + ا + ب = bāb."
    },
    {
      "id": "rd-l1-06",
      "type": "word",
      "arabic": "بات",
      "bangla": "রাত কাটাল",
      "english": "He stayed the night",
      "bn_transliteration": "বাত",
      "en_transliteration": "bāt",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ب + ا + ت। শুধু পড়ার অনুশীলন।",
      "note_en": "ب + ا + ت. Just reading practice."
    },
    {
      "id": "rd-l2-01",
      "type": "word",
      "arabic": "ج",
      "bangla": "উচ্চারণ: জ",
      "english": "Sound: j",
      "bn_transliteration": "জীম",
      "en_transliteration": "jīm",
      "category_ids": [
        "letters"
      ],
      "note_bn": "নিচে এক ফোঁটা। শুরু, মাঝ ও শেষে: جـ ـجـ ـج।",
      "note_en": "One dot below. Start, middle, end: جـ ـجـ ـج."
    },
    {
      "id": "rd-l2-02",
      "type": "word",
      "arabic": "ح",
      "bangla": "উচ্চারণ: হ (গলা চেপে, জোরে)",
      "english": "Sound: ḥ, a strong breathy h",
      "bn_transliteration": "হা (গলার)",
      "en_transliteration": "ḥā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "কোনো ফোঁটা নেই। সাধারণ 'হ'-এর চেয়ে গলা থেকে জোরে বের হয়। শুরু, মাঝ ও শেষে: حـ ـحـ ـح।",
      "note_en": "No dots. Breathed hard from the throat. Start, middle, end: حـ ـحـ ـح."
    },
    {
      "id": "rd-l2-03",
      "type": "word",
      "arabic": "خ",
      "bangla": "উচ্চারণ: খ (গলার খসখসে)",
      "english": "Sound: kh, like Scottish 'loch'",
      "bn_transliteration": "খা",
      "en_transliteration": "khā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ওপরে এক ফোঁটা। শুরু, মাঝ ও শেষে: خـ ـخـ ـخ।",
      "note_en": "One dot above. Start, middle, end: خـ ـخـ ـخ."
    },
    {
      "id": "rd-l2-04",
      "type": "word",
      "arabic": "تاج",
      "bangla": "মুকুট",
      "english": "Crown",
      "bn_transliteration": "তাজ",
      "en_transliteration": "tāj",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ت + ا + ج।",
      "note_en": "ت + ا + ج."
    },
    {
      "id": "rd-l2-05",
      "type": "word",
      "arabic": "حب",
      "bangla": "ভালোবাসা / দানা",
      "english": "Love; grain",
      "bn_transliteration": "হুব্ব",
      "en_transliteration": "ḥubb",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ح + ب।",
      "note_en": "ح + ب."
    },
    {
      "id": "rd-l2-06",
      "type": "word",
      "arabic": "خبز",
      "bangla": "রুটি",
      "english": "Bread",
      "bn_transliteration": "খুবয",
      "en_transliteration": "khubz",
      "category_ids": [
        "letters"
      ],
      "note_bn": "খ + ব + য। দোকানের সাইনে দেখবেন।",
      "note_en": "خ + ب + ز. You'll see it on bakery signs."
    },
    {
      "id": "rd-l3-01",
      "type": "word",
      "arabic": "د",
      "bangla": "উচ্চারণ: দ",
      "english": "Sound: d",
      "bn_transliteration": "দাল",
      "en_transliteration": "dāl",
      "category_ids": [
        "letters"
      ],
      "note_bn": "পরের অক্ষরের সাথে জোড়া লাগে না। শুরু, মাঝ ও শেষে: د ـد।",
      "note_en": "Never joins to the letter after it. Start, middle, end: د ـد."
    },
    {
      "id": "rd-l3-02",
      "type": "word",
      "arabic": "ذ",
      "bangla": "উচ্চারণ: য (জিভ দাঁতে, ইংরেজি this-এর th)",
      "english": "Sound: dh, the 'th' in 'this'",
      "bn_transliteration": "যাল",
      "en_transliteration": "dhāl",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ওপরে এক ফোঁটা। সৌদি কথায় প্রায়ই 'দ' শোনায়। পরের অক্ষরের সাথে জোড়া লাগে না। শুরু, মাঝ ও শেষে: ذ ـذ।",
      "note_en": "One dot above. Often sounds like d in Saudi speech. Never joins to the letter after it. Start, middle, end: ذ ـذ."
    },
    {
      "id": "rd-l3-03",
      "type": "word",
      "arabic": "ر",
      "bangla": "উচ্চারণ: র",
      "english": "Sound: r (rolled)",
      "bn_transliteration": "রা",
      "en_transliteration": "rā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "পরের অক্ষরের সাথে জোড়া লাগে না। শুরু, মাঝ ও শেষে: ر ـر।",
      "note_en": "Never joins to the letter after it. Start, middle, end: ر ـر."
    },
    {
      "id": "rd-l3-04",
      "type": "word",
      "arabic": "ز",
      "bangla": "উচ্চারণ: য (ইংরেজি z)",
      "english": "Sound: z",
      "bn_transliteration": "যা",
      "en_transliteration": "zāy",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ر-এর মতো, ওপরে এক ফোঁটা। পরের অক্ষরের সাথে জোড়া লাগে না। শুরু, মাঝ ও শেষে: ز ـز।",
      "note_en": "Like ر with a dot above. Never joins to the letter after it. Start, middle, end: ز ـز."
    },
    {
      "id": "rd-l3-05",
      "type": "word",
      "arabic": "دجاج",
      "bangla": "মুরগি",
      "english": "Chicken",
      "bn_transliteration": "দাজাজ",
      "en_transliteration": "dajāj",
      "category_ids": [
        "letters"
      ],
      "note_bn": "د + ج + ا + ج।",
      "note_en": "د + ج + ا + ج."
    },
    {
      "id": "rd-l3-06",
      "type": "word",
      "arabic": "رز",
      "bangla": "চাল / ভাত",
      "english": "Rice",
      "bn_transliteration": "রুয",
      "en_transliteration": "ruzz",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ر + ز — দুটোই জোড়া লাগে না, তাই আলাদা দেখায়।",
      "note_en": "ر + ز. Neither joins, so they stand apart."
    },
    {
      "id": "rd-l4-01",
      "type": "word",
      "arabic": "س",
      "bangla": "উচ্চারণ: স",
      "english": "Sound: s",
      "bn_transliteration": "সীন",
      "en_transliteration": "sīn",
      "category_ids": [
        "letters"
      ],
      "note_bn": "তিনটা ছোট দাঁত। শুরু, মাঝ ও শেষে: سـ ـسـ ـس।",
      "note_en": "Three small teeth. Start, middle, end: سـ ـسـ ـس."
    },
    {
      "id": "rd-l4-02",
      "type": "word",
      "arabic": "ش",
      "bangla": "উচ্চারণ: শ",
      "english": "Sound: sh",
      "bn_transliteration": "শীন",
      "en_transliteration": "shīn",
      "category_ids": [
        "letters"
      ],
      "note_bn": "س-এর ওপরে তিন ফোঁটা। শুরু, মাঝ ও শেষে: شـ ـشـ ـش।",
      "note_en": "Like س with three dots above. Start, middle, end: شـ ـشـ ـش."
    },
    {
      "id": "rd-l4-03",
      "type": "word",
      "arabic": "ص",
      "bangla": "উচ্চারণ: স (ভারী, মুখ গোল করে)",
      "english": "Sound: ṣ, a heavy s",
      "bn_transliteration": "সোয়াদ",
      "en_transliteration": "ṣād",
      "category_ids": [
        "letters"
      ],
      "note_bn": "শুরু, মাঝ ও শেষে: صـ ـصـ ـص।",
      "note_en": "Start, middle, end: صـ ـصـ ـص."
    },
    {
      "id": "rd-l4-04",
      "type": "word",
      "arabic": "ض",
      "bangla": "উচ্চারণ: দ (ভারী)",
      "english": "Sound: ḍ, a heavy d",
      "bn_transliteration": "দোয়াদ",
      "en_transliteration": "ḍād",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ص-এর ওপরে এক ফোঁটা। শুরু, মাঝ ও শেষে: ضـ ـضـ ـض।",
      "note_en": "Like ص with a dot above. Start, middle, end: ضـ ـضـ ـض."
    },
    {
      "id": "rd-l4-05",
      "type": "word",
      "arabic": "شارع",
      "bangla": "রাস্তা",
      "english": "Street",
      "bn_transliteration": "শারি",
      "en_transliteration": "shāriʿ",
      "category_ids": [
        "letters"
      ],
      "note_bn": "রাস্তার নামের বোর্ডে সবসময় থাকে।",
      "note_en": "On every street sign."
    },
    {
      "id": "rd-l4-06",
      "type": "word",
      "arabic": "صيدلية",
      "bangla": "ফার্মেসি",
      "english": "Pharmacy",
      "bn_transliteration": "সাইদালিইয়া",
      "en_transliteration": "ṣaydaliyya",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ফার্মেসির সাইনবোর্ডে দেখবেন।",
      "note_en": "You'll see it on pharmacy signs."
    },
    {
      "id": "rd-l5-01",
      "type": "word",
      "arabic": "ط",
      "bangla": "উচ্চারণ: ত (ভারী)",
      "english": "Sound: ṭ, a heavy t",
      "bn_transliteration": "তোয়া",
      "en_transliteration": "ṭā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "শুরু, মাঝ ও শেষে: طـ ـطـ ـط।",
      "note_en": "Start, middle, end: طـ ـطـ ـط."
    },
    {
      "id": "rd-l5-02",
      "type": "word",
      "arabic": "ظ",
      "bangla": "উচ্চারণ: য (ভারী)",
      "english": "Sound: ẓ, a heavy dh",
      "bn_transliteration": "যোয়া",
      "en_transliteration": "ẓā",
      "category_ids": [
        "letters"
      ],
      "note_bn": "ط-এর ওপরে এক ফোঁটা। শুরু, মাঝ ও শেষে: ظـ ـظـ ـظ।",
      "note_en": "Like ط with a dot above. Start, middle, end: ظـ ـظـ ـظ."
    },
    {
      "id": "rd-l5-03",
      "type": "word",
      "arabic": "ع",
      "bangla": "উচ্চারণ: আ (গলা চেপে)",
      "english": "Sound: ʿ, a tight throat sound",
      "bn_transliteration": "আইন",
      "en_transliteration": "ʿayn",
      "category_ids": [
        "letters"
      ],
      "note_bn": "বাংলায় নেই — গলা চেপে 'আ'। অডিও শুনে শুনে শিখুন। শুরু, মাঝ ও শেষে: عـ ـعـ ـع।",
      "note_en": "Not in English: a tight 'a' from the throat. Learn it by listening. Start, middle, end: عـ ـعـ ـع."
    },
    {
      "id": "rd-l5-04",
      "type": "word",
      "arabic": "غ",
      "bangla": "উচ্চারণ: গ (গলার, খসখসে)",
