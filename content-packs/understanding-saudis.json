    },
    {
      "id": "polite",
      "name_en": "Yes, no and thanks",
      "name_bn": "হ্যাঁ, না ও ধন্যবাদ",
      "order": 20
    },
    {
      "id": "papers",
      "name_en": "Salary, leave and iqama",
      "name_bn": "বেতন, ছুটি ও ইকামা",
      "order": 170
    }
  ],
  "items": [
    {
      "id": "us-l1-01",
      "type": "word",
      "arabic": "ليش؟",
      "bangla": "কেন?",
      "english": "Why?",
      "bn_transliteration": "লেইশ?",
      "en_transliteration": "lēsh?",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l1-02",
      "type": "word",
      "arabic": "مين؟",
      "bangla": "কে?",
      "english": "Who?",
      "bn_transliteration": "মীন?",
      "en_transliteration": "mīn?",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l1-03",
      "type": "word",
      "arabic": "وشلون؟",
      "bangla": "কীভাবে? / কেমন?",
      "english": "How?",
      "bn_transliteration": "উইশলোন?",
      "en_transliteration": "wishlōn?",
      "category_ids": [
        "slang"
      ],
      "note_bn": "'কেইফ'-এর মতোই। 'উইশলোনাক?' মানে কেমন আছেন?",
      "note_en": "Same as kēf. wishlōnak? means 'how are you?'"
    },
    {
      "id": "us-l1-04",
      "type": "word",
      "arabic": "كذا",
      "bangla": "এভাবে / এরকম",
      "english": "Like this",
      "bn_transliteration": "কিদা",
      "en_transliteration": "kidha",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l1-05",
      "type": "word",
      "arabic": "زين",
      "bangla": "ভালো / ঠিক আছে",
      "english": "Good, OK",
      "bn_transliteration": "যেইন",
      "en_transliteration": "zēn",
      "category_ids": [
        "slang"
      ],
      "note_bn": "সৌদিদের সবচেয়ে প্রিয় শব্দগুলোর একটি। 'যেইন?' = ঠিক আছে?",
      "note_en": "One of the most used Saudi words. zēn? = OK?"
    },
    {
      "id": "us-l1-06",
      "type": "word",
      "arabic": "مرة",
      "bangla": "খুব",
      "english": "Very",
      "bn_transliteration": "মাররা",
      "en_transliteration": "marra",
      "category_ids": [
        "slang"
      ],
      "note_bn": "'যেইন মাররা' = খুব ভালো। আবার 'মাররা' মানে 'একবার'ও।",
      "note_en": "zēn marra = very good. marra also means 'once'."
    },
    {
      "id": "us-l1-07",
      "type": "word",
      "arabic": "بعد",
      "bangla": "-ও (আমিও)",
      "english": "Too, also",
      "bn_transliteration": "বাআদ",
      "en_transliteration": "baʿad",
      "category_ids": [
        "slang"
      ],
      "note_bn": "'ওয়া আনা বাআদ' = আমিও।",
      "note_en": "w-ana baʿad = me too."
    },
    {
      "id": "us-l1-08",
      "type": "word",
      "arabic": "يعني",
      "bangla": "মানে...",
      "english": "I mean, like...",
      "bn_transliteration": "ইয়ানি",
      "en_transliteration": "yaʿni",
      "category_ids": [
        "slang"
      ],
      "note_bn": "কথার ফাঁকে ভাবতে ভাবতে সবাই বলে।",
      "note_en": "Everyone says it while thinking mid-sentence."
    },
    {
      "id": "us-l1-09",
      "type": "word",
      "arabic": "عاد",
      "bangla": "তো / আচ্ছা তাহলে",
      "english": "So, well then",
      "bn_transliteration": "আদ",
      "en_transliteration": "ʿād",
      "category_ids": [
        "slang"
      ],
      "note_bn": "জোর দিতে: 'খালাস আদ!' = ব্যস, এবার থামো!",
      "note_en": "For emphasis: khalāṣ ʿād! = OK, enough now!"
    },
    {
      "id": "us-l1-10",
      "type": "word",
      "arabic": "ترى",
      "bangla": "জেনে রাখো / আসলে",
      "english": "Just so you know",
      "bn_transliteration": "তারা",
      "en_transliteration": "tara",
      "category_ids": [
        "slang"
      ],
      "note_bn": "কিছু জানাতে বা সতর্ক করতে বাক্যের শুরুতে: 'তারা আনা তাবান'।",
      "note_en": "Starts a sentence to point something out: tara ana taʿbān."
    },
    {
      "id": "us-l1-11",
      "type": "phrase",
      "arabic": "يا خي",
      "bangla": "ভাই রে",
      "english": "Brother! (come on)",
      "bn_transliteration": "ইয়া খেই",
      "en_transliteration": "yā khi",
      "category_ids": [
        "slang"
      ],
      "note_bn": "বিরক্তি বা বোঝানোর সময় বলে।",
      "note_en": "Said when explaining or a bit annoyed."
    },
    {
      "id": "us-l1-12",
      "type": "phrase",
      "arabic": "يا رجال",
      "bangla": "আরে ভাই!",
      "english": "Come on, man!",
      "bn_transliteration": "ইয়া রাজ্জাল",
      "en_transliteration": "yā rajjāl",
      "category_ids": [
        "slang"
      ],
      "note_bn": "অবাক হলে বা 'না না' বোঝাতে।",
      "note_en": "Said when surprised, or to mean 'no way'."
    },
    {
      "id": "us-l2-01",
      "type": "phrase",
      "arabic": "وش السالفة؟",
      "bangla": "ঘটনা কী?",
      "english": "What's going on?",
      "bn_transliteration": "ওশ আস-সালফা?",
      "en_transliteration": "wesh as-sālfa?",
      "category_ids": [
        "slang"
      ],
      "note_bn": "'সালফা' মানে ঘটনা বা গল্প।",
      "note_en": "sālfa means story or situation."
    },
    {
      "id": "us-l2-02",
      "type": "word",
      "arabic": "حيل",
      "bangla": "খুব",
      "english": "Very, a lot",
      "bn_transliteration": "হেইল",
      "en_transliteration": "ḥēl",
      "category_ids": [
        "slang"
      ],
      "note_bn": "রিয়াদের (নজদি) কথা: 'তাবান হেইল' = খুব ক্লান্ত।",
      "note_en": "Najdi Riyadh word: taʿbān ḥēl = very tired."
    },
    {
      "id": "us-l2-03",
      "type": "word",
      "arabic": "واجد",
      "bangla": "অনেক",
      "english": "A lot, many",
      "bn_transliteration": "ওয়াজিদ",
      "en_transliteration": "wājid",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-04",
      "type": "word",
      "arabic": "أبد",
      "bangla": "একদম না / কোনো সমস্যা না",
      "english": "Not at all",
      "bn_transliteration": "আবাদ",
      "en_transliteration": "abad",
      "category_ids": [
        "slang"
      ],
      "note_bn": "'আবাদ' বললে প্রায়ই মানে 'কোনো ব্যাপার না'।",
      "note_en": "abad often means 'no problem at all'."
    },
    {
      "id": "us-l2-05",
      "type": "phrase",
      "arabic": "ولا يهمك",
      "bangla": "চিন্তা করবেন না",
      "english": "Don't worry about it",
      "bn_transliteration": "ওয়ালা ইহিম্মাক",
      "en_transliteration": "wala yhimmak",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-06",
      "type": "phrase",
      "arabic": "على كيفك",
      "bangla": "আপনার ইচ্ছামতো",
      "english": "As you like",
      "bn_transliteration": "আলা কেইফাক",
      "en_transliteration": "ʿala kēfak",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-07",
      "type": "word",
      "arabic": "كفو",
      "bangla": "সাবাস!",
      "english": "Well done!",
      "bn_transliteration": "কাফু",
      "en_transliteration": "kafu",
      "category_ids": [
        "slang"
      ],
      "note_bn": "খুব সৌদি প্রশংসা। কেউ ভালো কাজ করলে বলে।",
      "note_en": "Very Saudi praise for someone who did well."
    },
    {
      "id": "us-l2-08",
      "type": "phrase",
      "arabic": "يا حظك",
      "bangla": "তোমার কপাল ভালো",
      "english": "Lucky you!",
      "bn_transliteration": "ইয়া হাযযাক",
      "en_transliteration": "yā ḥaẓẓak",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-09",
      "type": "word",
      "arabic": "طفشان",
      "bangla": "বোর হচ্ছি",
      "english": "Bored",
      "bn_transliteration": "তাফশান",
      "en_transliteration": "ṭafshān",
      "category_ids": [
        "slang"
      ],
      "note_bn": "সৌদি তরুণদের খুব প্রিয় শব্দ।",
      "note_en": "A favourite word of young Saudis."
    },
    {
      "id": "us-l2-10",
      "type": "word",
      "arabic": "مبسوط",
      "bangla": "খুশি",
      "english": "Happy",
      "bn_transliteration": "মাবসূত",
      "en_transliteration": "mabsūṭ",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-11",
      "type": "word",
      "arabic": "خربان",
      "bangla": "নষ্ট / খারাপ",
      "english": "Broken, messed up",
      "bn_transliteration": "খারবান",
      "en_transliteration": "kharbān",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l2-12",
      "type": "phrase",
      "arabic": "تمام التمام",
      "bangla": "একদম ঠিক",
      "english": "Perfect",
      "bn_transliteration": "তামাম আত-তামাম",
      "en_transliteration": "tamām at-tamām",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l3-01",
      "type": "phrase",
      "arabic": "الله يحييك",
      "bangla": "আল্লাহ আপনাকে বাঁচিয়ে রাখুন (উত্তরে)",
      "english": "God greet you (reply)",
      "bn_transliteration": "আল্লাহ ইহাইয়িক",
      "en_transliteration": "allāh yḥayyīk",
      "category_ids": [
        "polite"
      ],
      "note_bn": "'হাইয়াক আল্লাহ'-র উত্তর।",
      "note_en": "The reply to ḥayyāk allāh."
    },
    {
      "id": "us-l3-02",
      "type": "phrase",
      "arabic": "الله يجزاك خير",
      "bangla": "আল্লাহ আপনাকে উত্তম প্রতিদান দিন",
      "english": "God reward you",
      "bn_transliteration": "আল্লাহ ইয়াজযাক খেইর",
      "en_transliteration": "allāh yajzāk khēr",
      "category_ids": [
        "polite"
      ],
      "note_bn": "বড় উপকারের জন্য ধন্যবাদ।",
      "note_en": "Thanks for a real favour."
    },
    {
      "id": "us-l3-03",
      "type": "phrase",
      "arabic": "الله يخليك",
      "bangla": "প্লিজ / আল্লাহ আপনাকে রাখুন",
      "english": "Please / Thank you",
      "bn_transliteration": "আল্লাহ ইখাল্লিক",
      "en_transliteration": "allāh ykhallīk",
      "category_ids": [
        "polite"
      ],
      "note_bn": "অনুরোধ করতে ('প্লিজ') আবার ধন্যবাদ দিতেও।",
      "note_en": "Used both to say please and to say thanks."
    },
    {
      "id": "us-l3-04",
      "type": "word",
      "arabic": "تكفى",
      "bangla": "দয়া করে (অনুরোধ)",
      "english": "Please, I beg you",
      "bn_transliteration": "তিকফা",
      "en_transliteration": "tikfa",
      "category_ids": [
        "polite"
      ],
      "note_bn": "খুব সৌদি। জোর দিয়ে অনুরোধ করতে। বন্ধুদের মধ্যে বেশি।",
      "note_en": "Very Saudi. A strong 'please', used more among friends."
    },
    {
      "id": "us-l3-05",
      "type": "phrase",
      "arabic": "ما قصرت",
      "bangla": "অনেক করেছেন, ধন্যবাদ",
      "english": "Thank you, you did plenty",
      "bn_transliteration": "মা গাসসারত",
      "en_transliteration": "mā gaṣṣart",
      "category_ids": [
        "polite"
      ],
      "note_bn": "কেউ সাহায্য করলে সৌদিরা খুব বলে।",
      "note_en": "Saudis say this a lot when someone helps them."
    },
    {
      "id": "us-l3-06",
      "type": "word",
      "arabic": "سم",
      "bangla": "জি, বলুন",
      "english": "Yes? (when called)",
      "bn_transliteration": "সাম্ম",
      "en_transliteration": "samm",
      "category_ids": [
        "polite"
      ],
      "note_bn": "কেউ নাম ধরে ডাকলে ভদ্র উত্তর — 'কী?' না বলে 'সাম্ম' বলুন।",
      "note_en": "The polite answer when someone calls your name, instead of 'what?'."
    },
    {
      "id": "us-l3-07",
      "type": "phrase",
      "arabic": "طال عمرك",
      "bangla": "আপনার দীর্ঘ জীবন হোক",
      "english": "Sir (may you live long)",
      "bn_transliteration": "তাল উমরাক",
      "en_transliteration": "ṭāl ʿumrak",
      "category_ids": [
        "polite"
      ],
      "note_bn": "বস, কফিল বা বড়দের সাথে কথায় সম্মান দেখাতে বাক্যে যোগ করুন।",
      "note_en": "Add it when talking to your boss, sponsor or elders to show respect."
    },
    {
      "id": "us-l3-08",
      "type": "phrase",
      "arabic": "الله يرحم والديك",
      "bangla": "আল্লাহ আপনার বাবা-মাকে রহম করুন",
      "english": "Please (bless your parents)",
      "bn_transliteration": "আল্লাহ ইয়ারহাম ওয়ালদেইক",
      "en_transliteration": "allāh yarḥam wāldēk",
      "category_ids": [
        "polite"
      ],
      "note_bn": "বিনয়ের সাথে কিছু চাওয়ার সময়, যেমন রাস্তা জানতে।",
      "note_en": "Used to ask a favour very politely, e.g. for directions."
    },
    {
      "id": "us-l3-09",
      "type": "phrase",
      "arabic": "عساك بخير",
      "bangla": "আশা করি ভালো আছেন",
      "english": "Hope you're well",
      "bn_transliteration": "আসাক বিখেইর",
      "en_transliteration": "ʿasāk bikhēr",
      "category_ids": [
        "polite"
      ]
    },
    {
      "id": "us-l3-10",
      "type": "word",
      "arabic": "بالعافية",
      "bangla": "ভালো করে খান",
      "english": "Enjoy your meal",
      "bn_transliteration": "বিল-আফিয়া",
      "en_transliteration": "bil-ʿāfya",
      "category_ids": [
        "polite"
      ],
      "note_bn": "কেউ খাচ্ছে দেখলে বলুন। উত্তর: 'আল্লাহ ইআফিক'।",
      "note_en": "Say it to someone eating. The reply is allāh yʿāfīk."
    },
    {
      "id": "us-l3-11",
      "type": "phrase",
      "arabic": "الله يحفظك",
      "bangla": "আল্লাহ আপনাকে হেফাজত করুন",
      "english": "God protect you",
      "bn_transliteration": "আল্লাহ ইয়াহফাযাক",
      "en_transliteration": "allāh yaḥfaẓak",
      "category_ids": [
        "polite"
      ]
    },
    {
      "id": "us-l4-01",
      "type": "word",
      "arabic": "والله؟",
      "bangla": "সত্যি?",
      "english": "Really?",
      "bn_transliteration": "ওয়াল্লাহ?",
      "en_transliteration": "wallāh?",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l4-02",
      "type": "word",
      "arabic": "صدق؟",
      "bangla": "সত্যি বলছেন?",
      "english": "Seriously?",
      "bn_transliteration": "সিদগ?",
      "en_transliteration": "ṣidg?",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l4-03",
      "type": "phrase",
      "arabic": "لا يكون",
      "bangla": "অসম্ভব! / হতেই পারে না",
      "english": "No way!",
      "bn_transliteration": "লা ইকূন",
      "en_transliteration": "lā ykūn",
      "category_ids": [
        "slang"
      ]
    },
    {
      "id": "us-l4-04",
      "type": "phrase",
      "arabic": "يا ساتر",
      "bangla": "হায় আল্লাহ",
      "english": "Oh my God",
      "bn_transliteration": "ইয়া সাতির",
      "en_transliteration": "yā sātir",
      "category_ids": [
        "slang"
      ],
      "note_bn": "ভয় বা অবাক হলে।",
      "note_en": "Said when shocked or scared."
    },
