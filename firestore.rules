rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admins are added by hand in the Firebase Console, never from the app
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each user can only check their own admin document
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Words and phrases: learners see published ones, admins see all
    match /items/{itemId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses and their lessons follow the same published/admin rule
    match /courses/{courseId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if resource.data.status == "published" || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Content version number for the device cache
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profile: streak, XP, daily goal. Users can never set their own plan.
    match /users/{userId} {
      // Admins can read every profile for Admin > Analytics
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny(["plan", "plan_expires_at"]);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["plan", "plan_expires_at"]);

      match /progress/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /lesson_progress/{lessonId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Admin > Analytics reads every learner's progress at once
    // (collection group queries), but never changes it
    match /{path=**}/progress/{itemId} {
      allow read: if isAdmin();
    }
    match /{path=**}/lesson_progress/{lessonId} {
      allow read: if isAdmin();
    }

    // One note per learner per day they open the app: {uid}_{day}.
    // Learners can only write their own; admins read them for the charts.
    match /activity/{activityId} {
      allow create, update: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        activityId == (request.auth.uid + "_" + request.resource.data.day);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Learners send feedback; only admins read it all
    match /feedback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000;
      allow read, delete: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
