rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admins are added by hand in the Firebase Console, never from the app
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each user can only check their own admin document
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Words and phrases: learners see published ones, admins see all
    match /items/{itemId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content version number for the device cache
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Each logged-in user can only read and write their own progress
    match /users/{userId}/progress/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
